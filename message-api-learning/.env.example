# .env.example — template for local environment variables.
# Copy this file to `.env` (which is gitignored) and fill in a real value.
# Every topic that actually calls the Messages API needs a real Anthropic
# API key — get one (and set up billing) at https://platform.claude.com/.
# Running the examples makes real, billed API calls.

ANTHROPIC_API_KEY=replace-with-a-real-key
