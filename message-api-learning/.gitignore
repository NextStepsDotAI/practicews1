# Dependencies — reinstalled from package-lock.json via `npm install`
node_modules/

# Compiled output from `tsc` (we normally run via ts-node, but a build is possible)
dist/

# Local environment variables — copy .env.example to .env and fill in real values;
# .env itself must never be committed since it holds a real API key.
.env

# Logs
npm-debug.log*
*.log

# Editor/OS noise
.vscode/
.DS_Store

# Claude Code: personal, machine-specific overrides (not shared with the team)
.claude/settings.local.json
